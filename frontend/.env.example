# Copy to frontend/.env.local.

# Backend URL. Local backend:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Or a deployed backend:
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# Supabase Realtime for live canvas and notification updates. Same project as
# the backend's SUPABASE_URL / SUPABASE_KEY (publishable key only).
# Blank: the app works but doesn't update live.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
