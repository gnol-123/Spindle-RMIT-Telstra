erDiagram
  projects ||--o{ usage_totals : "rolled up from messages"
  messages ||--o{ notifications : "status change"
  projects ||--o{ notifications : ""
  nodes ||--o{ notifications : ""
  auth_users ||--o{ push_subscriptions : devices
  notifications ||--o{ push_deliveries : ""
  push_subscriptions ||--o{ push_deliveries : ""

  auth_users { uuid id PK }
  projects { uuid id PK }
  nodes { uuid id PK }
  messages { uuid id PK }
  usage_totals {
    uuid project_id PK,FK
    uuid owner_id PK,FK
    text model PK
    bigint input_tokens
    bigint output_tokens
    bigint reasoning_tokens
    bigint cache_read_tokens
    bigint cache_write_tokens
    bigint requests
    bigint message_count
  }
  notifications {
    uuid id PK
    uuid owner_id FK
    uuid project_id FK
    uuid node_id FK
    uuid message_id FK
    text status "complete | failed | awaiting_approval"
    text node_name "copied at insert"
    text project_name "copied at insert"
    bool nested
    text excerpt
    timestamptz read_at
  }
  push_subscriptions {
    uuid id PK
    uuid owner_id FK
    text endpoint UK
    text p256dh
    text auth
    text user_agent
    timestamptz visible_until
  }
  push_deliveries {
    uuid notification_id PK,FK
    uuid subscription_id PK,FK
    timestamptz sent_at
  }
