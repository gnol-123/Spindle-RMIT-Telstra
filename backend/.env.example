# Copy to backend/.env. Every key maps to a field in app/config.py.
# Blank optional keys disable the feature named in the comment.

# --- App -------------------------------------------------------------------
APP_NAME=MuruDPipeline API
ENVIRONMENT=development
# Comma separated frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- Models ----------------------------------------------------------------
# "ollama" (hosted or local, OpenAI-compatible) or "gemini".
LLM_PROVIDER=ollama
# Hosted Ollama. A local install is http://localhost:11434/v1.
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
# Model for context edge summaries and project titles.
SUMMARY_MODEL=deepseek-v4.1-flash
# Used when LLM_PROVIDER=gemini, and always for voice transcription.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Read timeout for one model call, seconds.
LLM_READ_TIMEOUT_S=1800
# Model requests one turn may make. Per agent type override: agent_types.request_limit.
TURN_REQUEST_LIMIT=100

# --- Platform keys for built-in tools --------------------------------------
BRAVE_API_KEY=
CONTEXT7_API_KEY=

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=
# Publishable/anon key. User requests go through this, so RLS applies.
SUPABASE_KEY=
# Service role key. Bypasses RLS. Needed for Vault (tool secrets), turn
# recovery, Web Push and previews. Never expose to the frontend.
SUPABASE_SERVICE_KEY=

# --- Google sign-in --------------------------------------------------------
# Frontend URL Supabase returns the browser to after Google sign-in.
# Must also be allowlisted in Supabase > Authentication > URL Configuration.
OAUTH_REDIRECT_URL=

# --- OAuth tool nodes (Gmail etc) ------------------------------------------
# Google Cloud OAuth client, for tool connect flows (not sign-in).
GOOGLE_OAUTH_CLIENT_ID=
# Never expose to the frontend.
GOOGLE_OAUTH_CLIENT_SECRET=
# Random secret signing the connect flow's state param. Blank disables oauth2 tools.
OAUTH_STATE_SECRET=
# Frontend origin, to send the browser back after the oauth callback.
FRONTEND_URL=http://localhost:3000

# --- E2B sandboxes ---------------------------------------------------------
# Blank disables environments (provisioning writes an error status).
E2B_API_KEY=
E2B_TEMPLATE=base
# Template for sandboxes with browser tools; must run the mcp-gateway.
E2B_MCP_TEMPLATE=mcp-gateway
E2B_AUTO_RESUME=true
ENVIRONMENT_IDLE_TIMEOUT_S=300
ENVIRONMENT_COMMAND_TIMEOUT_S=120
ENVIRONMENT_MAX_OUTPUT_CHARS=20000
ENVIRONMENT_MAX_FILE_CHARS=200000
ENVIRONMENT_MAX_ARCHIVE_BYTES=200000000
ENVIRONMENT_MAX_UPLOAD_BYTES=25000000

# --- New project intent classifier (Jev, TypeSafe AI) ----------------------
# Blank: every prompt is treated as a project name.
JEV_API_KEY=
JEV_API_BASE=https://api.typesafe.ai
JEV_MODEL=jev-latest

# --- Web Push (VAPID) ------------------------------------------------------
# Any blank value, or no SUPABASE_SERVICE_KEY, disables push.
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# mailto: or https: contact for push services.
VAPID_SUBJECT=

# --- Shutdown --------------------------------------------------------------
# Grace period for detached turns to finish on shutdown, seconds.
DETACHED_JOIN_TIMEOUT_S=30
